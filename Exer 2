public class Retangulo {
    private double comprimento;
    private double largura;

    public Retangulo(){
        comprimento = 1;
        largura = 1;
    }

    public Retangulo(double comprimento, double largura){
        this.comprimento = comprimento;
        this.largura = largura;
    }

    public double getComprimento(){
        return comprimento;
    }

    public double getLargura(){
        return largura;
    }

    public double getPerimetro(){
        return comprimento + largura;
    }

    public double getArea(){
        return comprimento * largura;
    }
}


public class TesteRetangulo {
    public static void main(String[] args){
        Retangulo inicial = new Retangulo();
        System.out.println("Comprimento = " + inicial.getComprimento());
        System.out.println("Largura = " + inicial.getLargura());
        System.out.println("Perimetro = " + inicial.getPerimetro() + " Largura  = " + inicial.getArea());
        Retangulo CL = new Retangulo(3, 4);
        System.out.println("Comprimento = " + CL.getComprimento());
        System.out.println("Largura = " + CL.getLargura());
        System.out.println("Perimetro = " + CL.getPerimetro() + " Largura  = " + CL.getArea());
    }
}
